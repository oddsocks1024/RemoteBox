// Resources for RemoteBox.exe. version.h is generated by make-bundle.sh and
// defines RB_VERSION (e.g. "3.7"), RB_VERSION_BIN (e.g. 3,7,0,0) and ICON_FILE.
#include <winver.h>
#include "version.h"

1 ICON ICON_FILE

1 VERSIONINFO
FILEVERSION     RB_VERSION_BIN
PRODUCTVERSION  RB_VERSION_BIN
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Ian Chapman"
            VALUE "FileDescription",  "RemoteBox - VirtualBox client"
            VALUE "FileVersion",      RB_VERSION
            VALUE "InternalName",     "RemoteBox"
            VALUE "LegalCopyright",   "(c) 2010-2027 Ian Chapman. GPL licensed."
            VALUE "OriginalFilename", "RemoteBox.exe"
            VALUE "ProductName",      "RemoteBox"
            VALUE "ProductVersion",   RB_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 24 "remotebox.manifest"
